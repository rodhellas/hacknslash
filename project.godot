[layer_names]

3d_physics/layer_1="mondo"
3d_physics/layer_2="giocatore"
3d_physics/layer_3="nemici"
3d_physics/layer_4="interagibili"
3d_physics/layer_5="occlusione"
3d_render/layer_11="minimappa"

[navigation]

